{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@ny4n/chord": ["./packages/chord/src/index.ts"],
			"@ny4n/chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@ny4n/chord/context": ["./packages/chord/src/context/index.ts"],
			"@ny4n/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@ny4n/chord/node": ["./packages/chord/src/node.ts"],
			"@ny4n/telemetry": ["./packages/telemetry/src/index.ts"],
			"@ny4n/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@ny4n/codemode": ["./packages/codemode/src/index.ts"],
			"@ny4n/codemode/cloudflare": ["./packages/codemode/src/cloudflare.ts"],
			"@ny4n/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@ny4n/codemode/portable": ["./packages/codemode/src/portable.ts"],
			"@ny4n/codemode/search": ["./packages/codemode/src/search.ts"],
			"@ny4n/codemode/source": ["./packages/codemode/src/source.ts"],
			"@ny4n/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@ny4n/mcp": ["./packages/mcp/src/index.ts"],
			"@ny4n/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@ny4n/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@ny4n/ai": ["./packages/ai/src/index.ts"],
			"@ny4n/ai/contracts": ["./packages/ai/src/contracts/index.ts"],
			"@ny4n/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@ny4n/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@ny4n/ai/dist/*": ["./packages/ai/src/*"],
			"@ny4n/durable": ["./packages/durable/src/index.ts"],
			"@ny4n/durable/testing": ["./packages/durable/src/testing/index.ts"],
			"@ny4n/durable/*": [
				"./packages/durable/src/*.ts",
				"./packages/durable/src/*/index.ts",
				"./packages/durable/src/*"
			],
			"@ny4n/agent-core": ["./packages/agent/src/index.ts"],
			"@ny4n/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@ny4n/coding-agent/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@ny4n/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@ny4n/coding-agent/*": ["./packages/coding-agent/src/*"],
			"@ny4n/protocol": ["./packages/protocol/src/index.ts"],
			"@ny4n/protocol/*": ["./packages/protocol/src/*"],
			"@ny4n/client": ["./packages/client/src/index.ts"],
			"@ny4n/client/unix": ["./packages/client/src/unix.ts"],
			"@ny4n/client/*": ["./packages/client/src/*"],
			"@ny4n/server": ["./packages/server/src/index.ts"],
			"@ny4n/server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@ny4n/server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			// @anthropic-ai/sandbox-runtime 0.0.26 publishes Zod 3 declarations (`z.infer` on ZodObject).
			// The installed package is zod 4.6.7 so the production tree is outside GHSA-mrhx-c7xc-m3w5.
			// Point typechecking at zod/v3, the declaration shape those .d.ts files were emitted against.
			// Node and Bun still resolve the package's default entry, which is the patched Zod 4 runtime.
			"zod": ["./node_modules/zod/v3/index.d.ts"],
			"@ny4n/tui": ["./packages/tui/src/index.ts"],
			"@ny4n/tui/*": ["./packages/tui/src/*"]
		}
	},
	"include": ["scripts/model-catalog-protocol.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
